# Copy to .env (git-ignored) for local runs. On Render, set these in the dashboard instead.

# MongoDB Atlas — either a full URI, or the parts below
MONGODB_URI=
MONGODB_HOST=cluster0.example.mongodb.net
MONGODB_DATABASE=mdrakibtrofder
MONGODB_USER=
MONGODB_PASSWORD=

# Cloudinary — copy "API environment variable" from the Cloudinary dashboard
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=portfolio

# Comma-separated list of sites allowed to call the API from a browser
CORS_ORIGIN=https://mdrakibtrofder.github.io,http://localhost:8080

# Admin login (generate the hash with: npm run hash-password -- "your-password")
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=12h

# "Publish" button: triggers the GitHub Pages workflow.
# Fine-grained token with access to this repo only, permission "Actions: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=mdrakibtrofder/mdrakibtrofder.github.io
GITHUB_WORKFLOW=deploy.yml
GITHUB_REF=main

PORT=3000
